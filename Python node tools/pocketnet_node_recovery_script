    for p in peers:
        p_height = p.get("synced_blocks", 0)
        p_addr = p.get("addr", "unknown_ip")
        p_subver = p.get("subver", "unknown_client")
        p_id = str(p.get("id", ""))
        
        history_info = log_history.get(p_id, None)
        
        if p_height not in peer_distribution:
            peer_distribution[p_height] = []
        peer_distribution[p_height].append({
            "addr": p_addr, 
            "subver": p_subver, 
            "id": p_id,
            "history": history_info
        })

    hidden_count = 0

    for idx, tip in enumerate(tips):
        status = tip.get("status")
        height = tip.get("height")
        branch_len = tip.get("branchlen", 0)
        fork_block = height - branch_len
        tip_hash = tip.get("hash")
        
        # Hide old historical tips far behind or far ahead of current local height
        if status != "active" and abs(height - local_height) > 100:
            hidden_count += 1
            continue

        matched_peers = []
        nodes_on_tip = peer_distribution.get(height, [])
        matched_peers.extend(nodes_on_tip)

        nodes_on_branch = 0
        if branch_len > 0:
            for b_height in range(fork_block + 1, height):
                b_peers = peer_distribution.get(b_height, [])
                matched_peers.extend(b_peers)
        
        total_nodes_on_fork = len(matched_peers)

        # Apply Display Filter: Hide inactive forks or forks below MIN_PEERS_TO_SHOW threshold (except active chain)
        if status != "active" and total_nodes_on_fork < MIN_PEERS_TO_SHOW:
