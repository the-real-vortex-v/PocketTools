def load_config():
    """Loads configuration from file if it exists, otherwise creates it with defaults."""
    if os.path.exists(CONFIG_FILE_PATH):
        try:
            with open(CONFIG_FILE_PATH, "r", encoding="utf-8") as f:
                cfg = json.load(f)
                for k, v in DEFAULT_CONFIG.items():
                    if k not in cfg:
                        cfg[k] = v
                return cfg
        except Exception as e:
            print(f"{Fore.YELLOW}[WARN] Could not load config file, using defaults: {e}{Style.RESET_ALL}")
    save_config(DEFAULT_CONFIG)
    return DEFAULT_CONFIG.copy()

