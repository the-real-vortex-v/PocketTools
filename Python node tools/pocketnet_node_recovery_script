                print(f"   └── {Fore.YELLOW}0 direct peers synced to main chain tip.{Style.RESET_ALL}")
            print()
        else:
            hash_matched_in_errors = any(tip_hash in err['message'] for err in block_errors)
            error_flag_text = f" {Fore.RED}[🚨 MATCHED IN LOG ERRORS]{Style.RESET_ALL}" if hash_matched_in_errors else ""
            
            # Cross-reference with log history to see which peers explicitly triggered invalid/bad chain warnings
            bad_broadcasters = [p for p in matched_peers if p['history'] and p['history']['events'] > 0]

            print(f"{Fore.RED}[ACTIVE FORK #{idx}]{Style.RESET_ALL}{error_flag_text}")
            print(f"   ├── Status Type:  {status}")
            print(f"   ├── Split Height: Branch broken away from Main Chain at block {fork_block}")
            print(f"   ├── Fork Depth:   Progressed {branch_len} blocks deep onto its own path")
            print(f"   ├── Branch Tip:   Block {height}")
            print(f"   └── Tip Hash:     {tip_hash}")
            print(f"   └── {Fore.RED}Active Fork Peers ({total_nodes_on_fork} connected):{Style.RESET_ALL}")
            for peer in matched_peers:
                hist_text = f" | {Fore.RED}[⚠️ Flagged in logs: {peer['history']['events']} bad chain event(s)]{Style.RESET_ALL}" if peer['history'] and peer['history']['events'] > 0 else " | [Clean history]"
                print(f"        • IP: {peer['addr']} | Client: {peer['subver']}{hist_text}")
            
            if bad_broadcasters:
                print(f"   └── {Fore.YELLOW}⚠️ Suspicious Nodes Suspected of Serving/Broadcasting This Fork:{Style.RESET_ALL}")
                for bp in bad_broadcasters:
                    print(f"        • IP: {bp['addr']} | Last Bad Event: {bp['history']['last_reason']}")
            print()
            
    if hidden_count > 0:
        print(f"Note: Filtered out {hidden_count} old historical or low-peer fork branches.")

def fix_fork_at_height(height):
    """Manually invalidates a specific block height and rolls back the active chain."""
    print(f"\n{ICON_WRENCH} Attempting to resolve fork line at block height {height}...")
    block_hash = rpc_call("getblockhash", [int(height)])
    if not block_hash:
        print(f"{Fore.RED}{ICON_ERROR} Could not resolve the hash for block height {height}.{Style.RESET_ALL}")
        return False
        
    print(f"Target Block Hash found: {block_hash}")
    print("Sending 'invalidateblock' payload to node daemon memory...")
    rpc_call("invalidateblock", [block_hash])
    
    print(f"{Fore.GREEN}{ICON_SUCCESS} Block path marked as invalid and rolled back.{Style.RESET_ALL}")
    time.sleep(2)
    print("Sending 'reconsiderblock' payload to restart peer synchronization download from honest peers...")
    rpc_call("reconsiderblock", [block_hash])
    print(f"{Fore.GREEN}{ICON_SUCCESS} Reconsider command sent. Node will re-evaluate alternative valid headers.{Style.RESET_ALL}")
    return True

def auto_recover_forks():
    """Automated recovery workflow: evaluates chaintips, rollbacks bad history, and reconnects to seed nodes."""
    print(f"\n{ICON_WRENCH} --- STARTING AUTOMATED FORK RECOVERY ---")
    tips = rpc_call("getchaintips")
    if not tips:
        print(f"{Fore.RED}{ICON_ERROR} Unable to retrieve chaintips for automated analysis.{Style.RESET_ALL}")
        return

    active_tip = next((t for t in tips if t.get("status") == "active"), None)
    if not active_tip:
        print(f"{Fore.RED}{ICON_ERROR} No active chain tip found! Node database might be severely corrupted.{Style.RESET_ALL}")
        return

    active_status = active_tip.get("status")
    active_height = active_tip.get("height", 0)
    
    print(f"Current Active Tip Status: {active_status} at Height {active_height}")

    status_info = check_status()
    max_peer_height = status_info["max_peer_height"] if status_info else 0

    if active_status == "invalid" or (max_peer_height > 0 and active_height < max_peer_height - 5):
        print(f"{Fore.YELLOW}{ICON_WARN} Detected divergent or broken consensus state! Initiating corrective rollback...{Style.RESET_ALL}")
        
        target_rollback_height = None
        for tip in tips:
            if tip.get("status") != "active":
                branch_len = tip.get("branchlen", 0)
                height = tip.get("height", 0)
                split_height = height - branch_len
                if target_rollback_height is None or split_height < target_rollback_height:
                    target_rollback_height = split_height

        if target_rollback_height is None:
            target_rollback_height = max(0, active_height - 5)

        print(f"Calculated safe rollback target height: {target_rollback_height}")
        fix_fork_at_height(target_rollback_height)
        
        kickstart_peers()
        print(f"\n{Fore.GREEN}{ICON_SUCCESS} Automated recovery sequence executed successfully. Monitor logs for sync progress.{Style.RESET_ALL}")
    else:
        print(f"{Fore.GREEN}{ICON_SUCCESS} Node is on a healthy or active chain tip. No emergency rollback required.{Style.RESET_ALL}")

