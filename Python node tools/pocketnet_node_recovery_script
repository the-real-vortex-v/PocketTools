def rpc_call(method, params=[]):
    """Executes a JSON-RPC command against the local Bitcoin/Pocketcoin daemon with robust error handling."""
    payload = {"jsonrpc": "2.0", "id": "nodefix", "method": method, "params": params}
    try:
        response = requests.post(RPC_URL, auth=(RPC_USER, RPC_PASS), json=payload, timeout=15)
        
        if response.status_code == 500:
            # Suppressed as normal operation / unindexed hash lookup
            return None
        elif response.status_code != 200:
            print(f"{Fore.RED}{ICON_ERROR} RPC HTTP Error {response.status_code}: Check RPC URL/credentials or daemon status.{Style.RESET_ALL}")
            return None
            
        text = response.text.strip()
        if not text:
            return None
            
        res_json = response.json()
        if "error" in res_json and res_json["error"] is not None:
            return None
        return res_json.get("result")
    except requests.exceptions.ConnectionError:
        print(f"{Fore.RED}{ICON_ERROR} Failed to reach node: Connection refused at {RPC_URL}. Is pocketnetd running?{Style.RESET_ALL}")
        return None
    except requests.exceptions.Timeout:
        print(f"{Fore.RED}{ICON_ERROR} Failed to reach node: RPC request timed out after 15 seconds.{Style.RESET_ALL}")
        return None
    except json.JSONDecodeError:
        return None
    except Exception:
        return None

def node_top_dashboard():
    """Displays a real-time 'top'-like live status dashboard of node health, sync progress, and active forks with color-coded peers."""
    global PEER_RECOVERY_DURATION
    print(f"\n{Fore.CYAN}📊 Starting Node Health & Fork 'Top' Dashboard (Press Ctrl+C to exit)...{Style.RESET_ALL}")
    try:
        while True:
            # Fetch all RPC and chaintips data FIRST before clearing the screen
            blockchain_info = rpc_call("getblockchaininfo")
            network_info = rpc_call("getnetworkinfo")
            peer_info = rpc_call("getpeerinfo") or []
            tips = rpc_call("getchaintips") or []
            
            if not blockchain_info or not network_info:
                print(f"{Fore.RED}{ICON_ERROR} Daemon offline or unreachable. Retrying in 3s...{Style.RESET_ALL}")
                time.sleep(3)
                continue

            local_height = blockchain_info.get("blocks", 0)
            headers_height = blockchain_info.get("headers", 0)
            difficulty = blockchain_info.get("difficulty", 0)
            connections = network_info.get("connections", 0)
            protocol_ver = network_info.get("protocolversion", 0)
            
            max_peer_height = 0
            if peer_info:
                peer_heights = [p.get("synced_blocks", 0) for p in peer_info]
                max_peer_height = max(peer_heights) if peer_heights else 0

            # Filter for ACTIVE / UNRESOLVED forks close to current local height (e.g. within 100 blocks)
            # Exclude old historical valid-forks / valid-headers deep in the past and dead/inactive forks
            active_forks = []
            for t in tips:
                status = t.get("status")
                if status != "active" and status != "invalid":
                    f_height = t.get("height", 0)
                    # Only consider active forks close to our current chain tip (unresolved / current forks)
                    if abs(f_height - local_height) <= 100:
                        active_forks.append(t)

            # Clear screen right before rendering the updated display
            print("\033[H\033[J", end="")
            print("==================================================")
            print(f"{Fore.CYAN}🟢 PKOIN NODE LIVE HEALTH & FORK 'TOP' MONITOR{Style.RESET_ALL}")
            print("==================================================")
            
            print(f"🕒 Timestamp:          {time.strftime('%Y-%m-%d %H:%M:%S')}")
            print(f"🧱 Local Height:       {Fore.GREEN}{local_height}{Style.RESET_ALL} (Headers: {headers_height})")
            print(f"🌐 Max Peer Height:    {Fore.YELLOW}{max_peer_height}{Style.RESET_ALL}")
            
            if active_forks:
                print(f"🚨 FORK STATUS:        {Fore.RED}ACTIVE FORK(S) DETECTED ({len(active_forks)} current divergent branch tip(s)){Style.RESET_ALL}")
            else:
                if max_peer_height > local_height:
                    print(f"⚠️ Sync Status:        Behind peers by {max_peer_height - local_height} blocks")
                else:
                    print(f"✨ Sync Status:        Fully Synced / Chain Healthy")
                    
            print(f"🔗 Active Connections: {connections}")
            print(f"⚙️ Protocol Version:   {protocol_ver}")
            print(f"⛏️ Mining Difficulty:  {difficulty}")
            
            if active_forks:
                print(f"\n{Fore.RED}--- 🌿 ACTIVE UNRESOLVED BLOCKCHAIN FORKS ---{Style.RESET_ALL}")
                for idx, fork in enumerate(active_forks):
                    f_status = fork.get("status")
                    f_height = fork.get("height", 0)
                    f_branch = fork.get("branchlen", 0)
                    f_split = f_height - f_branch
                    f_hash = fork.get("hash")
                    
                    diff_blocks = f_height - local_height
                    if diff_blocks > 0:
                        diff_str = f"Ahead of local tip by {diff_blocks} blocks"
                    elif diff_blocks < 0:
                        diff_str = f"Behind local tip by {abs(diff_blocks)} blocks"
                    else:
                        diff_str = f"At exact same height as local tip"

                    # Find peers currently synced to this specific fork tip or branch
                    fork_peers = [p for p in peer_info if p.get("synced_blocks", 0) == f_height or (f_split <= p.get("synced_blocks", 0) <= f_height)]

                    print(f"  • Fork #{idx+1} [{f_status.upper()}]")
                    print(f"    - Split Height: {f_split} | Depth: {f_branch} blocks deep")
                    print(f"    - Tip Height:   {f_height} ({diff_str})")
                    print(f"    - Tip Hash:     {f_hash}")
                    if fork_peers:
                        print(f"    - {Fore.RED}Nodes on this Bad Fork ({len(fork_peers)} connected):{Style.RESET_ALL}")
                        for fp in fork_peers:
                            print(f"        • IP: {fp.get('addr', 'unknown')} | Synced Height: {fp.get('synced_blocks', 0)} | Client: {fp.get('subver', 'unknown').replace('/', '')}")
                    else:
                        print(f"    - {Fore.YELLOW}No direct connected peers currently stuck on this fork tip height.{Style.RESET_ALL}")
                print(f"{Fore.YELLOW}ℹ️ Tip: Use Option [6] or [7] from the main menu to rollback and recover if stuck.{Style.RESET_ALL}")
            else:
                print(f"\n{Fore.GREEN}--- 🌿 NO ACTIVE UNRESOLVED FORKS DETECTED ---{Style.RESET_ALL}")

            print(f"\n--- ALL CONNECTED PEERS ({len(peer_info)}) ---")
            if peer_info:
                print(f"{'IP Address':<22} | {'Height':<8} | {'Ping':<8} | {'Status / Client'}")
                print("-" * 75)
                current_time = time.time()
                for p in peer_info:
                    addr = p.get("addr", "unknown")[:21]
                    synced = p.get("synced_blocks", 0)
                    ping = f"{p.get('pingtime', 0)*1000:.0f}ms" if 'pingtime' in p else "N/A"
                    subver = p.get("subver", "unknown").replace("/", "")[:18]
                    
                    is_forked_peer = any(f.get("height") == synced for f in active_forks)
                    connect_time = p.get("conntime", current_time)
                    time_since_conn = current_time - connect_time
                    
                    if is_forked_peer:
                        color = Fore.RED
                        status_label = "[FORKED]"
                    elif time_since_conn < PEER_RECOVERY_DURATION:
                        color = Fore.YELLOW
                        status_label = "[RECOVERED]"
                    else:
                        color = Fore.GREEN
                        status_label = "[HEALTHY]"
                        
                    print(f"{color}{addr:<22} | {synced:<8} | {ping:<8} | {status_label} {subver}{Style.RESET_ALL}")
            else:
                print(f"{Fore.RED}No active peers connected.{Style.RESET_ALL}")

            print("\nPress Ctrl+C to return to main menu.")
            time.sleep(3)
    except KeyboardInterrupt:
        print(f"\n{Fore.GREEN}Exiting live health & fork dashboard.{Style.RESET_ALL}")

