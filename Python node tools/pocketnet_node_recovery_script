def check_status():
    """Performs comprehensive diagnostics on node height, header sync, and peer health."""
    print(f"\n{ICON_CHECK} --- RUNNING NODE DIAGNOSTICS ---")
    blockchain_info = rpc_call("getblockchaininfo")
    network_info = rpc_call("getnetworkinfo")
    peer_info = rpc_call("getpeerinfo") or []
    
    if not blockchain_info or not network_info:
        print(f"{Fore.RED}{ICON_ERROR} Cannot diagnose. Daemon is offline or RPC credentials are wrong.{Style.RESET_ALL}")
        return None

    local_height = blockchain_info.get("blocks", 0)
    headers_height = blockchain_info.get("headers", 0)
    connections = network_info.get("connections", 0)
    is_ibd = blockchain_info.get("initialblockdownload", False)

    print(f"Local Block Height:     {local_height}")
    print(f"Best Header Height:     {headers_height}")
    print(f"Connected Peers:        {connections}")
    print(f"Initial Block Download: {is_ibd}")

    max_peer_height = 0
    if peer_info:
        peer_heights = [p.get("synced_blocks", 0) for p in peer_info]
        max_peer_height = max(peer_heights) if peer_heights else 0
        print(f"Max Peer Height:        {max_peer_height}")
        
        if local_height < max_peer_height:
            print(f"{Fore.YELLOW}{ICON_WARN} STATUS: Node is lagging behind peers by {max_peer_height - local_height} blocks.{Style.RESET_ALL}")
        elif local_height == max_peer_height and local_height < headers_height:
            print(f"{Fore.YELLOW}{ICON_WARN} STATUS: Node is stuck on a bad block fork. Peers cannot feed us new blocks.{Style.RESET_ALL}")
        else:
            print(f"{Fore.GREEN}{ICON_SUCCESS} STATUS: Node height matches its active peers.{Style.RESET_ALL}")
    else:
        print(f"{Fore.RED}{ICON_ERROR} STATUS: CRITICAL! Node has 0 connected peers. It is completely isolated.{Style.RESET_ALL}")
        
    return {
        "local_height": local_height,
        "headers_height": headers_height,
        "max_peer_height": max_peer_height,
        "connections": connections
    }

def kickstart_peers():
    """Clears stale/banned nodes and injects healthy seed nodes to restore network reachability."""
    print(f"\n{ICON_ROCKET} Clearing banned node list and injecting clean seed connections...")
    rpc_call("clearbanned")
    print(f"{Fore.GREEN}{ICON_SUCCESS} Local node ban list cleared.{Style.RESET_ALL}")
    
    added_count = 0
    for seed in SEED_NODES:
        result = rpc_call("addnode", [seed, "add"])
        if result is not None:
            print(f"{ICON_PLUS} Injected seed peer: {seed}")
            added_count += 1
    print(f"Kickstart complete. Attempted to force-inject {added_count} seed peers.")

def scan_debug_log_for_bad_chains(force_rescan=False):
    """Scans live debug.log and compressed archives (.zip, .tar, .tgz, .bz2, .7z) for peer bad-chain events and block/tx errors."""
    historical_data = load_persistence_cache()
    if historical_data and not force_rescan:
        print(f"{Fore.GREEN}{ICON_CACHE} Using cached historical peer record (run option 7 to force full log re-ingestion).{Style.RESET_ALL}")
        return historical_data

    print(f"\n{ICON_CACHE} Scanning debug logs and compressed archives for historical peer events and errors...")
    new_historical_data = {}
    
    log_files_to_scan = []
    if os.path.exists(DEBUG_LOG_PATH):
        log_files_to_scan.append(DEBUG_LOG_PATH)
        
    if os.path.exists(LOG_ARCHIVES_DIR):
        for root, dirs, files in os.walk(LOG_ARCHIVES_DIR):
            for file in files:
                full_path = os.path.join(root, file)
                if any(file.endswith(ext) for ext in [".zip", ".tar", ".gz", ".tgz", ".bz2", ".7z"]):
                    log_files_to_scan.append(full_path)

    for path in log_files_to_scan:
        try:
            if path.endswith(".zip"):
                with zipfile.ZipFile(path, 'r') as z:
                    for filename in z.namelist():
                        if "debug.log" in filename or filename.endswith(".log"):
                            with z.open(filename) as f:
                                lines = [line.decode('utf-8', errors='ignore') for line in f.readlines()]
                                new_historical_data = parse_log_lines(lines, new_historical_data)
            elif path.endswith(".tar") or path.endswith(".tgz") or path.endswith(".gz"):
                with tarfile.open(path, 'r:*') as tar:
                    for member in tar.getmembers():
                        if member.isfile() and ("debug.log" in member.name or member.name.endswith(".log")):
                            f = tar.extractfile(member)
                            if f:
                                lines = [line.decode('utf-8', errors='ignore') for line in f.readlines()]
                                new_historical_data = parse_log_lines(lines, new_historical_data)
            elif path.endswith(".bz2"):
                with bz2.BZ2File(path, 'rb') as bz:
                    lines = [line.decode('utf-8', errors='ignore') for line in bz.readlines()]
                    new_historical_data = parse_log_lines(lines, new_historical_data)
            elif path.endswith(".7z"):
                if HAS_7Z:
                    try:
                        import tempfile
                        with tempfile.TemporaryDirectory() as tmpdir:
                            with py7zr.SevenZipFile(path, mode='r') as sz:
                                sz.extractall(path=tmpdir)
                            for root_t, dirs_t, files_t in os.walk(tmpdir):
                                for ft in files_t:
                                    if "debug.log" in ft or ft.endswith(".log"):
                                        with open(os.path.join(root_t, ft), 'rb') as f_7z:
                                            lines = [line.decode('utf-8', errors='ignore') for line in f_7z.readlines()]
                                            new_historical_data = parse_log_lines(lines, new_historical_data)
                    except Exception as sz_err:
                        print(f"{Fore.YELLOW}{ICON_WARN} Could not parse 7z archive {path}: {sz_err}{Style.RESET_ALL}")
                else:
                    print(f"{Fore.YELLOW}{ICON_WARN} Found .7z archive {path}, but 'py7zr' module is not installed. Run 'pip install py7zr' to support 7z archives.{Style.RESET_ALL}")
            elif path == DEBUG_LOG_PATH:
                with open(path, 'r', encoding='utf-8', errors='ignore') as f:
                    lines = f.readlines()
                    new_historical_data = parse_log_lines(lines, new_historical_data)
        except Exception as e:
            print(f"{Fore.YELLOW}{ICON_WARN} Could not parse archive/log {path}: {e}{Style.RESET_ALL}")

    save_persistence_cache(new_historical_data)
    return new_historical_data

def parse_log_lines(lines, historical_data):
    """Parses raw text log lines to extract peer bad-chain/invalid events and transaction/block reconstruct errors."""
    for line in lines:
        # Ignore GUI update check logs as requested
        if "GUI: Check updates" in line or "gui: check updates" in line.lower():
            continue

        if "peer=" in line:
            try:
                parts = line.split("peer=")
                peer_id_part = parts[1].split()[0]
                timestamp = line[:19] if len(line) >= 19 else "unknown_time"
                
                if any(term in line.lower() for term in ["bad", "invalid", "stale", "orphan", "reject", "disconnect", "non-standard"]):
                    if peer_id_part not in historical_data:
                        historical_data[peer_id_part] = {
                            "events": 0, 
                            "first_seen": timestamp, 
                            "last_seen": timestamp,
                            "last_reason": line.strip()
                        }
                    historical_data[peer_id_part]["events"] += 1
                    historical_data[peer_id_part]["last_seen"] = timestamp
                    historical_data[peer_id_part]["last_reason"] = line.strip()
            except Exception:
                continue
                
        # Capture specific block/transaction accessor/reconstruct errors indicating corrupted state or fork conflicts
        if "Error:" in line or "error:" in line or "Accessor::GetBlock" in line or "reconstruct failed" in line or "LevelDB" in line:
            timestamp = line[:19] if len(line) >= 19 else "unknown_time"
            if "block_errors" not in historical_data:
                historical_data["block_errors"] = []
            if line.strip() not in [err["message"] for err in historical_data["block_errors"]]:
                historical_data["block_errors"].append({
                    "timestamp": timestamp,
                    "message": line.strip()
                })
    return historical_data

def inspect_block_and_transaction(block_hash, txid):
    """Queries daemon to resolve block height, check if it's on active or dead chain, and inspect transaction details."""
    result_info = {
        "block_hash": block_hash,
        "block_height": "Unknown",
        "chain_status": "Unknown",
        "txid": txid,
        "tx_type": "Unknown",
        "is_malformed": False,
        "is_abandoned": False,
        "is_coinstake": False,
        "details": "",
        "malformation_reason": ""
    }

    # 1. Try to get block info via getblock (Active Chain)
    block_json = rpc_call("getblock", [block_hash])
    if block_json:
        result_info["block_height"] = block_json.get("height", "Unknown")
        result_info["chain_status"] = "Active Chain (Verified in active local blockchain database)"
        
        txs = block_json.get("tx", [])
        if txid in txs:
            result_info["details"] = f"Transaction {txid} is referenced in block header at height {result_info['block_height']}, but failed local reconstruction."
        else:
            result_info["details"] = f"Block found at height {result_info['block_height']}, but txid {txid} was not in this block's tx list."
    else:
        # Block not found in active chain view -> check getblockheader
        header_json = rpc_call("getblockheader", [block_hash])
        if header_json:
            result_info["block_height"] = header_json.get("height", "Unknown")
            result_info["chain_status"] = "Dead / Alternative Fork Chain (Header exists in index, but block data unlinked or on stale/invalid fork)"
            result_info["details"] = f"Block header found at height {result_info['block_height']} on a dead or alternative fork branch."
        else:
            result_info["block_height"] = "Not found in local database"
            result_info["chain_status"] = "Dead Fork / Corrupted State / Pruned"
            result_info["details"] = f"Block hash {block_hash} not found in active chain or header index. It belongs to an unlinked dead fork."

    # 2. Inspect Transaction via getrawtransaction
    if txid:
        tx_json = rpc_call("getrawtransaction", [txid, True])
        if tx_json:
            result_info["is_abandoned"] = tx_json.get("abandoned", False)
            vin = tx_json.get("vin", [])
            vout = tx_json.get("vout", [])
            
            if vin and "coinbase" in vin[0]:
                result_info["tx_type"] = "Coinbase (PoW Mint / Block Reward)"
            else:
                result_info["tx_type"] = "Standard Transfer / Pocketnet Content Post / Action Tx"
            
            if any("coinstake" in str(v).lower() for v in vout) or (len(vin) > 0 and "scriptSig" in vin[0] and len(vin[0]["scriptSig"].get("asm", "")) == 0):
                result_info["is_coinstake"] = True
                result_info["tx_type"] = "Coin Stake (PoS Mint)"
                
            result_info["is_malformed"] = False
        else:
            result_info["is_malformed"] = True
            result_info["tx_type"] = "Unknown / Unindexable Transaction Data"
            result_info["malformation_reason"] = (
                "The transaction index database (LevelDB) returned no return data for this txid. "
                "This typically happens due to a database corruption, a missing .ldb file in the chainstate, "
                "or a transaction that was accepted on an invalid fork branch whose transaction index was never fully reconstructed."
            )

    return result_info

def generate_fork_tree():
    """Inspects chain tips, maps divergent consensus forks, and groups active peers according to MIN_PEERS_TO_SHOW threshold."""
    print(f"\n{ICON_TREE} --- GENERATING NETWORK FORK TREE & HISTORICAL PEER MAP ---")
    tips = rpc_call("getchaintips")
    blockchain_info = rpc_call("getblockchaininfo") or {}
    local_height = blockchain_info.get("blocks", 0)
    peers = rpc_call("getpeerinfo") or []
    
    if not tips:
